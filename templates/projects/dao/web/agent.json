      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "personalTestOwner()",
      "mutability": "view",
      "description": "Returns the owner address of the personal-test policy, or zero if personal-test mode is off.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "personalTestPolicy()",
      "mutability": "view",
      "description": "Returns the personal-test policy tuple: marker, owner address, native cap and token cap.",
      "moves_funds": false,
      "example": {
