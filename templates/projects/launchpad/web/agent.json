      "mutability": "nonpayable",
      "description": "Sets the amount of the caller's tokens the spender may transfer, replacing any earlier allowance.",
      "moves_funds": true,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111",
          "1000000000000000000"
        ]
      }
    },
    {
      "id": "TestToken",
      "address": "{{address:TestToken}}",
