          "word": 3,
          "label": "발행됨",
          "show": "count"
        },
        {
          "id": "cap",
          "call": "editionOf(uint256)",
          "args": [
            "$edition"
          ],
          "word": 2,
          "label": "최대 수량",
          "show": "count"
        },
        {
          "id": "cost",
          "call": "editionOf(uint256)",
          "args": [
            "$edition"
          ],
          "word": 5,
          "label": "발행 금액",
          "show": "native"
        },
        {
          "call": "balanceOf(address,uint256)",
          "args": [
            "$account",
            "$edition"
