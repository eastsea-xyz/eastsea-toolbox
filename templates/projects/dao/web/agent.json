      "mutability": "view",
      "description": "Returns the proposal record: execution hash, voting end, executable-from time, expiry and executed flag.",
      "moves_funds": false,
      "example": {
        "args": [
          "1"
        ]
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "propose(bytes32)",
      "mutability": "nonpayable",
      "description": "Opens a proposal that commits to the hash of target, value and data; anyone may call while the brake is open.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "SimpleDAO",
