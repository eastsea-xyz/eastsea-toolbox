      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "approvedVotes(uint256,address)",
      "mutability": "view",
      "description": "Returns whether the voter has recorded an on-chain approval for the proposal.",
      "moves_funds": false,
      "example": {
        "args": [
          "1",
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "brakeGuardian()",
      "mutability": "view",
      "description": "Returns the guardian address that may engage the brake.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "brakeSpec()",
      "mutability": "pure",
      "description": "Returns the URI and document hash that describe the brake policy.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "brakeState()",
      "mutability": "view",
      "description": "Returns the current brake level, the guardian address and the timestamp when the brake last changed.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "checkPersonalTestTokenReceipt(address)",
      "mutability": "nonpayable",
      "description": "Lets a registered token report a receipt so the personal-test token cap is checked; only callable by the token itself in personal-test mode.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "domainSeparator()",
      "mutability": "view",
      "description": "Returns the current EIP-712 domain separator for this DAO and chain.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "eip712Domain()",
      "mutability": "view",
      "description": "Returns the EIP-712 domain fields: name, version, chain id and verifying contract.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "engageBrake(uint8)",
      "mutability": "nonpayable",
      "description": "Raises the brake to a stronger level (1 or 2) to block new entries; only the guardian may call it and it cannot be lowered.",
      "moves_funds": false,
      "example": {
        "args": [
          "1"
        ]
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "execute(uint256,address,uint256,bytes,bytes[])",
      "mutability": "nonpayable",
      "description": "Runs the proposal's committed call from the treasury once its timelock has passed and signers' token weight reaches quorum; may send native coin. Anyone may submit.",
      "moves_funds": true,
      "example": {
        "args": [
          "1",
          "0x1111111111111111111111111111111111111111",
          "1000000000000000000",
          "0x",
          []
        ]
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "executeWithSigners(uint256,address,uint256,bytes,address[],bytes[])",
      "mutability": "nonpayable",
      "description": "Runs the proposal's committed call from the treasury after the timelock, counting signed or on-chain approvals that reach quorum; may send native coin. Anyone may submit.",
      "moves_funds": true,
      "example": {
        "args": [
          "1",
          "0x1111111111111111111111111111111111111111",
          "1000000000000000000",
          "0x",
          [
            "0x1111111111111111111111111111111111111111",
            "0x2222222222222222222222222222222222222222"
          ],
          [
            "0x",
            "0x"
          ]
        ]
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "getVoteHash(uint256)",
      "mutability": "view",
      "description": "Returns the EIP-712 digest voters sign to approve the proposal.",
      "moves_funds": false,
      "example": {
        "args": [
          "1"
        ]
      }
    },
    {
      "id": "SimpleDAO",
      "address": "{{address:SimpleDAO}}",
      "function": "gracePeriod()",
      "mutability": "view",
