{
  "format": "eastsea-agent-interface/1",
  "app_id": "{{app_id}}",
  "name": "Kelp Kiosk",
  "category": "tools",
  "summary": "Prepaid orders for agent work: settled on delivery before a deadline, else refunded.",
  "contracts": [
    {
      "id": "AgentVending",
      "contract": "AgentVending",
      "address": "{{address:AgentVending}}"
    }
  ],
  "functions": [
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "PERSONAL_TEST_MAGIC()",
      "mutability": "view",
      "description": "Returns the constant identifier that marks a personal-test deployment policy.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "agent()",
      "mutability": "view",
      "description": "Returns the address that fulfils orders and receives payment on delivery.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "brakeGuardian()",
      "mutability": "view",
      "description": "Returns the guardian address that alone may engage the emergency brake, fixed at deployment.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "brakeSpec()",
      "mutability": "pure",
      "description": "Returns the brake specification URI and its document hash.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "brakeState()",
      "mutability": "view",
      "description": "Returns the current brake state (0 normal, 1 new entries blocked, 2 fully paused), the guardian and the time it was engaged.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "checkPersonalTestTokenReceipt(address)",
      "mutability": "nonpayable",
      "description": "Lets a personal-test token notify this contract of a receipt so the token holding cap is checked; reverts if the cap is exceeded.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "deliver(uint256,bytes32)",
      "mutability": "nonpayable",
      "description": "Records delivery of an open order before its deadline and pays the order price to the agent; callable only by the agent.",
      "moves_funds": true,
      "example": {
        "args": [
          "1",
          "0x1111111111111111111111111111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "engageBrake(uint8)",
      "mutability": "nonpayable",
      "description": "Raises the emergency brake to a higher state (1 blocks new entries, 2 pauses more); callable only by the guardian and cannot be lowered.",
      "moves_funds": false,
      "example": {
        "args": [
          "1"
        ]
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "fulfilWindow()",
      "mutability": "view",
      "description": "Returns the seconds an order has to be delivered.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "instanceMode()",
      "mutability": "view",
      "description": "Returns 'personal-test' if deployed under a personal-test policy, otherwise 'testnet'.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "order(bytes32)",
      "mutability": "payable",
      "description": "Places an order for a specification hash by paying exactly the price; blocked while the brake blocks entries.",
      "moves_funds": true,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111111111111111111111111111"
        ],
        "value_wei": "1000000000000000000"
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "orderCount()",
      "mutability": "view",
      "description": "Returns how many orders have been placed.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "orders(uint256)",
      "mutability": "view",
      "description": "Returns the buyer and delivery deadline of an open order; zeros once delivered or refunded.",
      "moves_funds": false,
      "example": {
        "args": [
          "1"
        ]
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "personalTestAllowed(address)",
      "mutability": "view",
      "description": "Returns whether an account is on this instance's personal-test allow list.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "personalTestAuthority()",
      "mutability": "view",
      "description": "Returns the deployment authority address that vouches for related personal-test instances, or zero when not in personal-test mode.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "personalTestEnabled()",
      "mutability": "view",
      "description": "Returns whether this instance runs under a personal-test policy that limits callers and held value.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "personalTestNativeCap()",
      "mutability": "view",
      "description": "Returns the maximum native coin balance this instance may hold in personal-test mode, or zero otherwise.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "personalTestOwner()",
      "mutability": "view",
      "description": "Returns the owner account of the personal-test policy, or zero when not in personal-test mode.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "personalTestPolicy()",
      "mutability": "view",
      "description": "Returns the personal-test policy tuple: marker, owner, native coin cap and token cap.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "personalTestTokenCap()",
      "mutability": "view",
      "description": "Returns the maximum total raw token units this instance may hold in personal-test mode, or zero otherwise.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "price()",
      "mutability": "view",
      "description": "Returns the price of one order in wei.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "refund(uint256)",
      "mutability": "nonpayable",
      "description": "Returns the order price to the buyer after the delivery deadline passed undelivered; callable only by the buyer.",
      "moves_funds": true,
      "example": {
        "args": [
          "1"
        ]
      }
    },
    {
      "id": "AgentVending",
      "address": "{{address:AgentVending}}",
      "function": "setPersonalTestAccount(address,bool)",
      "mutability": "nonpayable",
      "description": "Adds or removes an account on the personal-test allow list; callable only by the policy owner, who cannot be removed.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111",
          "true"
        ]
      }
    }
  ]
}
