{
  "format": "eastsea-agent-interface/1",
  "app_id": "{{app_id}}",
  "name": "Tide Pass",
  "category": "payments",
  "summary": "Time-based access paid per second, with partial refunds on cancel.",
  "contracts": [
    {
      "id": "SubscriptionManager",
      "contract": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}"
    }
  ],
  "functions": [
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "PERSONAL_TEST_MAGIC()",
      "mutability": "view",
      "description": "Returns the constant marker value that identifies personal-test mode in the deploy policy.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "brakeGuardian()",
      "mutability": "view",
      "description": "Returns the guardian address that may engage the brake.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "brakeSpec()",
      "mutability": "pure",
      "description": "Returns the URI and document hash that describe the brake policy.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "brakeState()",
      "mutability": "view",
      "description": "Returns the current brake level, the guardian address and the timestamp when the brake last changed.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "cancel()",
      "mutability": "nonpayable",
      "description": "Ends the caller's active subscription and refunds the remaining seconds at the fixed rate in native coin.",
      "moves_funds": true,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "checkPersonalTestTokenReceipt(address)",
      "mutability": "nonpayable",
      "description": "Lets a registered token report a receipt so the personal-test token cap is checked; only callable by the token itself in personal-test mode.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "claimRevenue()",
      "mutability": "nonpayable",
      "description": "Sends the balance not reserved for refunds to the payee in native coin; anyone may trigger it.",
      "moves_funds": true,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "claimableRevenue()",
      "mutability": "view",
      "description": "Returns the balance that could currently be sent to the payee, being balance minus refund reserve.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "engageBrake(uint8)",
      "mutability": "nonpayable",
      "description": "Raises the brake to a stronger level (1 or 2) to block new entries; only the guardian may call it and it cannot be lowered.",
      "moves_funds": false,
      "example": {
        "args": [
          "1"
        ]
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "instanceMode()",
      "mutability": "view",
      "description": "Returns the text 'personal-test' if this instance was deployed under a personal-test policy, otherwise 'testnet'.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "isSubscribed(address)",
      "mutability": "view",
      "description": "Returns whether the address has an unexpired subscription.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "payee()",
      "mutability": "view",
      "description": "Returns the address that receives subscription revenue.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "personalTestAllowed(address)",
      "mutability": "view",
      "description": "Returns whether the given account is on the personal-test allow list for this instance.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "personalTestAuthority()",
      "mutability": "view",
      "description": "Returns the policy authority address used to recognize allowed sibling instances, or zero outside personal-test mode.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "personalTestEnabled()",
      "mutability": "view",
      "description": "Returns true if this instance was deployed in personal-test mode with access and value caps.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "personalTestNativeCap()",
      "mutability": "view",
      "description": "Returns the maximum native coin balance this instance may hold in personal-test mode, or 0 if disabled.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "personalTestOwner()",
      "mutability": "view",
      "description": "Returns the owner address of the personal-test policy, or zero if personal-test mode is off.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "personalTestPolicy()",
      "mutability": "view",
      "description": "Returns the personal-test policy tuple: marker, owner address, native cap and token cap.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "personalTestTokenCap()",
      "mutability": "view",
      "description": "Returns the maximum token amount this instance may hold in personal-test mode, or 0 if disabled.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "ratePerSecond()",
      "mutability": "view",
      "description": "Returns the price in wei per second of subscription.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "refundReserve()",
      "mutability": "view",
      "description": "Returns the sum of active subscribers' paid amounts held back for possible refunds.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "setPersonalTestAccount(address,bool)",
      "mutability": "nonpayable",
      "description": "Adds or removes an account on the personal-test allow list; only the personal-test owner may call it and the owner cannot be removed.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111",
          "true"
        ]
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "settleExpired(address)",
      "mutability": "nonpayable",
      "description": "Releases an expired subscriber's paid amount from the refund reserve so it counts as revenue; anyone may call and no funds move.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "subscribe()",
      "mutability": "payable",
      "description": "Extends the caller's subscription by the seconds the sent native coin buys at the fixed rate; needs open brake.",
      "moves_funds": true,
      "example": {
        "args": [],
        "value_wei": "1000000000000000"
      }
    },
    {
      "id": "SubscriptionManager",
      "address": "{{address:SubscriptionManager}}",
      "function": "subscribers(address)",
      "mutability": "view",
      "description": "Returns the subscriber record: expiry timestamp and amount contributed in the current streak.",
      "moves_funds": false,
      "example": {
        "args": [
          "0x1111111111111111111111111111111111111111"
        ]
      }
    }
  ]
}
