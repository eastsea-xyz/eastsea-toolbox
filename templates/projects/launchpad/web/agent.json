    {
      "id": "TestToken",
      "contract": "FixedSupplyToken",
      "address": "{{address:TestToken}}"
    },
    {
      "id": "AmmFactory",
      "contract": "AmmFactory",
      "address": "{{address:AmmFactory}}"
    },
    {
      "id": "BondingLaunchpad",
      "contract": "BondingLaunchpad",
      "address": "{{address:BondingLaunchpad}}"
    }
  ],
  "functions": [
    {
      "id": "TestToken",
      "address": "{{address:TestToken}}",
      "function": "DOMAIN_SEPARATOR()",
      "mutability": "view",
      "description": "Returns the EIP-712 domain separator used to verify permit signatures.",
      "moves_funds": false,
      "example": {
        "args": []
      }
    },
    {
      "id": "TestToken",
      "address": "{{address:TestToken}}",
      "function": "PERSONAL_TEST_MAGIC()",
      "mutability": "view",
